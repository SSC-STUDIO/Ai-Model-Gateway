# AI Model Gateway - Docker environment variables
# Copy this file to secrets.env and fill in real values.
# secrets.env is loaded by docker-compose.yaml and injected into the container.
# NEVER commit secrets.env to git.

# Provider API keys
OPENCODE_API_KEY=
OTHERSAPI_API_KEY=
MIMO_API_KEY=

# Admin tokens (use strong random values in production)
ADMIN_BOOTSTRAP_TOKEN=
COOKIE_SIGNING_KEY=
ADMIN_TOKEN=
VIEWER_TOKEN=
